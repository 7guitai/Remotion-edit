  "slides": [
    {
      "type": "trivia",
      "text": "知らないと損する\n体の雑学7選",
      "speech": "知らないと損する、体の雑学、七選",
      "image": "body_kagaku_jintai_mokei.png"
    },
    {
      "type": "trivia",
      "text": "大人の骨の数は",
      "image": "gaikotsu_character.png",
      "answer": "約206本",
      "answerSpeech": "約二百六本",
      "note": "※赤ちゃんは300本ほどあり成長でくっつく",
      "no": 1
    },
    {
      "type": "trivia",
      "text": "大人の体の水分は",
      "image": "sports_suibun_hokyuu_woman.png",
      "answer": "体重の約60%",
      "answerSpeech": "体重の約六十パーセント",
      "note": "※赤ちゃんはもっと多い",
      "no": 2
    },
    {
      "type": "trivia",
      "text": "舌の場所ごとに\n感じる味が違う",
      "speech": "舌の場所ごとに、感じる味が違う",
      "image": "fe_tongue.svg",
      "answer": "というのはウソ",
      "note": "※舌のどこでも全部の味を感じられる",
      "no": 3
    },
    {
      "type": "trivia",
      "text": "人がまばたきする回数は",
      "image": "fe_eye.svg",
      "answer": "1日に1万回以上",
      "answerSpeech": "一日に一万回以上",
      "note": "※目の表面を乾かさないため",
      "no": 4
    },
    {
      "type": "trivia",
      "text": "胃の内側の粘膜は",
      "image": "body_i.png",
      "answer": "数日で\n生まれ変わる",
      "note": "※強い胃酸から胃を守るため",
      "no": 5
    },
    {
      "type": "trivia",
      "text": "鼻をつまんで食べると",
      "image": "pose_kusai_woman.png",
      "answer": "味が\n分かりにくくなる",
      "note": "※味の多くは香りで感じている",
      "no": 6
    },
    {
      "type": "trivia",
      "text": "手の爪が伸びる速さは",
      "image": "tsumekiri_woman.png",
      "answer": "1日に約0.1mm",
      "answerSpeech": "一日に約れいてんいちミリ",
      "note": "※足の爪は手よりゆっくり",
      "no": 7
    }
  ],
