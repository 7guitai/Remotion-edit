  "slides": [
    {
      "type": "thread",
      "text": "貯金1000万\n貯めて\n分かったこと\n書いてく",
      "image": "money_tsuchou_happy_woman.png",
      "speech": "貯金一千万貯めて、分かったこと書いてく"
    },
    {
      "type": "thread",
      "text": "先取り貯金が\n最強",
      "image": "kyuryou_bonus_man2.png",
      "replies": [
        {
          "text": "給料日に別口座へ\n自動で移すだけ"
        },
        {
          "text": "「余ったら貯金」は\n一生貯まらんぞ"
        }
      ]
    },
    {
      "type": "thread",
      "text": "固定費から\n削れ",
      "image": "money_hokensyouken.png",
      "replies": [
        {
          "text": "格安SIMにしたら\n月5000円浮いた",
          "speech": "格安シムにしたら、月五千円浮いた"
        },
        {
          "text": "保険も見直したら\n入りすぎてたわ"
        }
      ]
    },
    {
      "type": "thread",
      "text": "コンビニに\n毎日寄るな",
      "image": "reji_cashier_supermarket_man.png",
      "replies": [
        {
          "text": "1日500円でも\n年間18万円やぞ",
          "speech": "一日五百円でも、年間十八万円やぞ"
        },
        {
          "text": "マイボトルに変えた\nだけで全然違う"
        }
      ]
    },
    {
      "type": "thread",
      "text": "見栄を張るのを\nやめろ",
      "image": "shopping_brand_goods.png",
      "replies": [
        {
          "text": "車は中古で十分",
          "speech": "車は中古でじゅうぶん"
        },
        {
          "text": "ブランド物なんて\n誰も見てないぞ",
          "speech": "ブランドものなんて誰も見てないぞ"
        }
      ]
    },
    {
      "type": "thread",
      "text": "新NISAは\nやっとけ",
      "image": "tsumitate_man.png",
      "speech": "新ニーサは、やっとけ",
      "replies": [
        {
          "text": "長期・積立・分散が\n基本やで"
        },
        {
          "text": "ただし生活防衛資金を\n先に貯めてからな"
        }
      ]
    },
    {
      "type": "thread",
      "text": "結局は\n続けたやつが\n勝つ",
      "image": "money_chokinbako.png",
      "replies": [
        {
          "text": "最初の100万が\nいちばんキツい",
          "speech": "最初の百万が、いちばんキツい"
        },
        {
          "text": "当たり前のことを\n淡々と続けるだけ"
        }
      ]
    },
    {
      "type": "thread",
      "text": "参考になったら\n高評価\nたのむ",
      "image": "money_chokin_seikou_woman.png",
      "replies": [
        {
          "text": "チャンネル登録も\nよろしくな"
        }
      ]
    }
  ],
