  "slides": [
    {
      "type": "trivia",
      "text": "知らないと損する\n日本の雑学7選",
      "speech": "知らないと損する、日本の雑学、七選",
      "image": "nihonchizu.png"
    },
    {
      "type": "trivia",
      "text": "日本の島の数は",
      "image": "nishinoshim_shintou_niijima.png",
      "answer": "約1万4000島",
      "answerSpeech": "約一万四千島",
      "note": "※2023年に数え直して倍以上に",
      "no": 1
    },
    {
      "type": "trivia",
      "text": "日本の国鳥は",
      "image": "bird_kiji.png",
      "answer": "キジ",
      "note": "※桃太郎のお供でもおなじみ",
      "no": 2
    },
    {
      "type": "trivia",
      "text": "日本の国花は",
      "image": "ohanami_sakura_zensen.png",
      "answer": "法律では\n決まっていない",
      "note": "※桜や菊が国花とされることが多い",
      "no": 3
    },
    {
      "type": "trivia",
      "text": "世界最古の会社と\nいわれるのは",
      "image": "building_tera.png",
      "answer": "日本の金剛組",
      "note": "※578年創業のお寺などを建てる会社",
      "no": 4,
      "speech": "世界最古の会社と、いわれるのは"
    },
    {
      "type": "trivia",
      "text": "日本の自動販売機は",
      "image": "machine_jidouhanbaiki.png",
      "answer": "約400万台もある",
      "answerSpeech": "約四百万台もある",
      "note": "※世界でもトップクラスの多さ",
      "no": 5
    },
    {
      "type": "trivia",
      "text": "富士山の山頂は",
      "image": "fujisan_shikaku.png",
      "answer": "神社の土地",
      "note": "※8合目より上は富士山本宮浅間大社の境内",
      "no": 6
    },
    {
      "type": "trivia",
      "text": "日本の電気は",
      "image": "denryoku_soudensen.png",
      "answer": "東と西で\n周波数が違う",
      "note": "※東日本は50Hz　西日本は60Hz",
      "no": 7
    }
  ],
