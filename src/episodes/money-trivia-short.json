  "slides": [
    {
      "type": "trivia",
      "text": "知らないと損する\nお金の雑学7選",
      "speech": "知らないと損する、お金の雑学、七選",
      "image": "money_satsutaba2.png"
    },
    {
      "type": "trivia",
      "text": "お札1枚を作るのに\nかかるお金は",
      "speech": "お札一枚を作るのにかかるお金は",
      "image": "money_10000.png",
      "answer": "約20円\nといわれている",
      "answerSpeech": "約二十円と言われている",
      "no": 1
    },
    {
      "type": "trivia",
      "text": "破れたお札は",
      "image": "money_yabure.png",
      "answer": "3分の2以上残っていれば\n全額と交換できる",
      "answerSpeech": "三分の二以上残っていれば、全額と交換できる",
      "note": "※5分の2以上なら半額",
      "no": 2
    },
    {
      "type": "trivia",
      "text": "同じ硬貨を\n21枚以上出すと",
      "speech": "同じ硬貨を、二十一枚以上出すと",
      "image": "ryougae_kozeni.png",
      "answer": "お店は受け取りを\n断ることができる",
      "note": "※法律で20枚までと決まっている",
      "no": 3
    },
    {
      "type": "trivia",
      "text": "年末ジャンボの\n1等が当たる確率は",
      "speech": "年末ジャンボの一等が当たる確率は",
      "image": "takarakuji.png",
      "answer": "約2000万分の1",
      "answerSpeech": "約二千万分の一",
      "no": 4
    },
    {
      "type": "trivia",
      "text": "お札に人の顔が\n描かれているのは",
      "image": "money_nisesatsu_10000_yen.png",
      "answer": "ニセ札を\n見分けやすくするため",
      "note": "※顔のわずかな違いに人は気づきやすい",
      "no": 5
    },
    {
      "type": "trivia",
      "text": "お札の原料は",
      "image": "washi_paper.png",
      "answer": "ミツマタやマニラ麻など\n植物からできている",
      "no": 6
    },
    {
      "type": "trivia",
      "text": "1万円札の寿命は",
      "speech": "一万円札の寿命は",
      "image": "money_kusyakusya.png",
      "answer": "約4〜5年",
      "answerSpeech": "約四年から五年",
      "note": "※千円札は1〜2年ほど",
